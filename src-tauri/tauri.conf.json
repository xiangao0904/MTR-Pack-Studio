{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MTR Pack Studio",
  "version": "0.1.0",
  "identifier": "studio.mtrpack.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "MTR Pack Studio", "width": 1440, "height": 900, "minWidth": 900, "minHeight": 650, "decorations": false }],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": "all" }
}
