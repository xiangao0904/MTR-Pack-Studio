<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <?if $(sys.BUILDARCH) = x86 ?>
    <?define Win64 = "no" ?>
  <?else ?>
    <?define Win64 = "yes" ?>
  <?endif ?>
  <Fragment>
    <DirectoryRef Id="INSTALLDIR">
      <!-- Match the ProgId generated by Tauri's MSI template. Windows Installer
           owns this value and removes it on uninstall. The ICO is a bundled resource. -->
      <Component Id="MtrpackFileIcon" Guid="8D8A8F85-17F0-4C98-AB41-3D3572D1B978" Win64="$(var.Win64)">
        <RegistryValue Root="HKLM"
                       Key="Software\Classes\MTR Pack Studio.mtrpack\DefaultIcon"
                       Type="string" Value="&quot;[INSTALLDIR]icons\mtrpack.ico&quot;,0"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Fragment>
</Wix>
